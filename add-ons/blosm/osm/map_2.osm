  <node id="5162719842" lat="48.8571935" lon="2.3594904" version="2" timestamp="2023-07-29T16:53:57Z" changeset="139181261" uid="7550430" user="Britzz">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Ici habitait Yvette FEUILLET Sergent F.F.I. Citée à l'Ordre de la Résistance Assassinée par les Nazis à Auschwitz à l'âge de 22 ans"/>
    <tag k="memorial" v="plaque"/>
    <tag k="noname" v="yes"/>
  </node>
  <node id="5163747598" lat="48.8568600" lon="2.3598901" version="2" timestamp="2020-07-15T17:26:30Z" changeset="88044570" uid="1842888" user="nihombashi19">
    <tag k="board_type" v="history"/>
    <tag k="historic" v="memorial"/>
    <tag k="information" v="board"/>
    <tag k="inscription:1" v="ATTENTAT ANTISÉMITE LE 9 AOÛT 1982 ICI DANS LE RESTAURANT GOLDENBERG UNE FUSILLADE ET L'EXPLOSION D'UNE GRENADE ONT FAIT 6 MORTS ET 22 BLESSÉS. À LA MÉMOIRE DE MOHAMED BENEMMON, ANDRÉ HEZKIA NIEGO, GRACE CUTER, ANNE VAN ZANIEN,"/>
    <tag k="inscription:2" v="DENISE GUERCHE ROSSIGNOL, GEORGES DEMETER, VICTIMES DU TERRORISME"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Attentat du 9 août 1982"/>
  </node>
  <node id="5163747599" lat="48.8570147" lon="2.3598305" version="2" timestamp="2023-07-27T20:34:29Z" changeset="139106443" uid="7550430" user="Britzz">
    <tag k="historic" v="memorial"/>
    <tag k="inscription:1" v="A LA MEMOIRE DE ROSETTE (12 ans) et son père HERSZ LEWKOWICZ, ESTHER et HENRI MERKIER, ESTHER ITA SOKOL, PAULETTE (1 mois) et VICTOR (2 ans), Et leur mère RYWKA WAJNCWAIG. Déportés de 1942 à 1944 par les nazis parce que nés juifs."/>
    <tag k="inscription:2" v="Avec la complicité active du gouvernement de Vichy, et exterminés dans les camps de la mort."/>
    <tag k="memorial" v="plaque"/>
  </node>
  <node id="5200979741" lat="48.8549869" lon="2.3564294" version="2" timestamp="2022-12-20T20:38:21Z" changeset="130305473" uid="7550430" user="Britzz">
    <tag k="board_type" v="history"/>
    <tag k="historic" v="memorial"/>
    <tag k="information" v="board"/>
    <tag k="inscription:1" v="PASSAGE AMPLIFIÉ - Oeuvre sonore de Miriam Bäckstrom et Carsten Höllet - Commande publique de la Ville de Paris"/>
    <tag k="inscription:2" v="En hommage aux enfants juifs de la France déportés pendant la Seconde Guerre Mondiale. De 1942 à 1944, 11400 enfants juifs, dont 6100 parisiens, ont été déportés de France vers les camps d’extermination avec la complicité du gouvernement de Vichy."/>
    <tag k="inscription:3" v="De ces enfants, presque tous assassinés, il ne reste que la mémoire que l’on veut bien garder d’eux. Pour que vive cette mémoire, les artistes Miriam Bäckström et Carsten Höller proposent ici une œuvre sonore : Passage amplifié."/>
    <tag k="inscription:4" v="Les voix et les sons de la ville sont captés par des micros et amplifiés, sans être enregistrés, en étant subtilement modifiés, de telle manière que, dans un espace délimité, ils semblent ne venir de nulle part. Transformées, distanciées, rendues à une"/>
    <tag k="inscription:5" v="forme d’intimité, les voix d’un instance deviennent celles d’une mémoire toujours à renouveler et qui porte parmi les vivants le souvenir des disparus."/>
    <tag k="memorial" v="plaque"/>
  </node>
  <node id="5200979742" lat="48.8549862" lon="2.3564313" version="2" timestamp="2022-12-20T20:38:21Z" changeset="130305473" uid="7550430" user="Britzz">
    <tag k="board_type" v="history"/>
    <tag k="historic" v="memorial"/>
    <tag k="information" v="board"/>
    <tag k="inscription" v="Collège François COUPERIN dit &quot;LE GRAND&quot; 1668-1733 AUTEUR DE &quot;L’ART DE ROUCHER LE CLAVECIN&quot; IL TINT LES ORGUES de l’EGLISE St GERVAIS."/>
    <tag k="memorial" v="plaque"/>
  </node>
  <node id="5200979743" lat="48.8549831" lon="2.3564384" version="2" timestamp="2022-12-20T20:38:21Z" changeset="130305473" uid="7550430" user="Britzz">
    <tag k="board_type" v="history"/>
    <tag k="historic" v="memorial"/>
    <tag k="information" v="board"/>
    <tag k="inscription:1" v="ARRÉTÉS PAR LA POLICE DU GOUVERNEMENT DE VICHY, COMPLICE DE L’OCCUPANT NAZI, PLUS DE 11000 ENFANTS FURENT DÉPORTÉS DE FRANCE DE 1942 A 1944 ET ASSASSINÉS À AUSCHWITZ PARCE QU’ILS ÉTAIENT NÉS JUIFS. PLUS DE 500 ENFANTS VIVAIENT DANS LE 4ème"/>
    <tag k="inscription:2" v="ARRONDISSEMENT, PARMI EUX LES ÉLÈVES DE CETTE ÉCOLE. NE LES OUBLIONS JAMAIS. Le 15 décembre 2001."/>
    <tag k="memorial" v="plaque"/>
    <tag k="start_date" v="15-12-2001"/>
  </node>
